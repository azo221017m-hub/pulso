{
  "name": "pulso",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace=apps/api",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "build:shared": "npm run build --workspace=packages/shared",
    "deploy:build": "npm run build:shared && npm run build --workspace=apps/api",
    "deploy:start": "npm run start:deploy --workspace=apps/api",
    "test:api": "npm run test --workspace=apps/api"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "bcrypt@5.1.1": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true
  }
}
