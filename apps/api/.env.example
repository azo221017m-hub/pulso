# Neon (or Supabase) Postgres. DATABASE_URL is the pooled connection (pgbouncer) used at
# runtime; DIRECT_URL is the unpooled connection Prisma needs to run migrations. Neon's
# dashboard gives you both strings directly — no local Postgres/Docker required.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/pulso?sslmode=require"
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/pulso?sslmode=require"

JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
PORT=3000

# Número de WhatsApp que recibe las activaciones de TSQ8 (spec §7). Solo dígitos, con código de
# país, sin "+" ni espacios (formato que espera el deep link wa.me). Nunca se hardcodea en el
# frontend ni en más de un lugar del código.
TSQ8_DESTINATION_PHONE="525527618631"
